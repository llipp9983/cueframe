{
  "name": "cueframe",
  "productName": "CUEFRAME",
  "version": "1.7.0",
  "description": "CUEFRAME - 방송 대기화면 편집기",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "vitest run",
    "dist": "vite build && electron-builder --publish never"
  },
  "build": {
    "appId": "StandbyScreen",
    "productName": "CUEFRAME",
    "files": [
      "dist/**",
      "electron/**",
      "src/core/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CUEFRAME",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "CUEFRAME-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "llipp9983",
        "repo": "cueframe"
      }
    ],
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "compression": "maximum",
    "extraResources": [
      {
        "from": "assets/templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "font-list": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^2.5.0",
    "ws": "^8.22.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/do-hyeon": "^5.3.0",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "pretendard": "^1.3.9",
    "sharp": "^0.35.5",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "author": "llipp9983"
}
