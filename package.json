{
  "name": "cueframe",
  "productName": "CUEFRAME",
  "version": "1.0.0",
  "description": "CUEFRAME - 방송 대기화면 편집기",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "vitest run",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "StandbyScreen",
    "productName": "CUEFRAME",
    "files": [
      "dist/**",
      "electron/**",
      "src/core/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^2.5.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
